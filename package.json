{
  "name": "constructa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run start -w apps/mobile",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/db.ts",
    "test": "npm run test -w packages/shared",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "supabase": "^2.122.1"
  }
}
